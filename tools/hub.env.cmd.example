@echo off
rem Copy to tools\hub.env.cmd and fill in on the store PC. hub.env.cmd is git-ignored: keys stay on the PC.
set "PICKLE_DRIVE=G:\내 드라이브\피클"
set "ANTHROPIC_API_KEY="
set "OPENAI_API_KEY="
set "HUB_MONTHLY_BUDGET=30"
rem Data sources (see README): the order app's Apps Script URL and the HR board password
set "ORDER_APP_API="
set "HR_BOARD_PASSWORD="
rem Kitchen screen on the phone. HUB_SCREEN_URL is the https address Vercel gives.
rem HUB_SYNC_SECRET is the same value as on the Vercel project. Leave both empty to stay local-only.
set "HUB_SCREEN_URL="
set "HUB_SYNC_SECRET="
